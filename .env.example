

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ZORUNLU: RLS ile kilitlenmis tablolar (teacher_users vb.) icin.
# Supabase > Project Settings > API > service_role. ASLA NEXT_PUBLIC_ yapmayin.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
SUPABASE_URL=your_supabase_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Optional: Development Settings
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Guvenlik anahtarlari (ZORUNLU) ---
# Uretmek icin:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Oturum cerezlerini imzalar. Degisirse tum kullanicilar cikis yapar.
SESSION_SECRET=en_az_32_karakterlik_rastgele_deger

# Ogretmen sifrelerinin arama indeksini ve sifrelemesini turetir.
# DEGISTIRMEYIN: degisirse tum ogretmen sifreleri gecersiz olur ve yeniden uretilmeleri gerekir.
PASSWORD_SECRET=en_az_32_karakterlik_rastgele_deger

# Ilk kurulumda yonetici sifresi. Ilk basarili giriste app_settings tablosuna
# hash lenerek kaydedilir; sonrasinda panel uzerinden degistirilir.
ADMIN_PASSWORD=ilk_yonetici_sifresi
